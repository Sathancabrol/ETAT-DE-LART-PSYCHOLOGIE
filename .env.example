# ============================================================
# Agent de recherche littéraire — copier vers .env et remplir.
# JAMAIS committé (.env est dans .gitignore).
# ============================================================

# Cerveau LLM : none | openai | ollama
#   none    → mode 100% heuristique (gratuit, sans clé, jugements automatisés conservateurs)
#   openai  → tout endpoint compatible OpenAI (OpenAI, Mistral, Groq, vLLM, LM Studio…)
#   ollama  → modèle local via Ollama (http://localhost:11434)
AGENT_PROVIDER=none
AGENT_MODEL=gpt-4o-mini
AGENT_BASE_URL=https://api.openai.com/v1

# Clé API (ou variable classique OPENAI_API_KEY). Ne jamais committer.
AGENT_API_KEY=

# Email pour le "polite pool" OpenAlex/Crossref (recommandé : votre vrai email)
AGENT_EMAIL=agent-demo@example.org

# Optionnel : activer Semantic Scholar comme 4e source (rate-limitée)
AGENT_S2_ENABLED=0
